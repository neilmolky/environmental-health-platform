{
  "name": "Environmental Health Platform (Workspace)",
  "dockerComposeFile": [
    "../docker-compose.dev.yml"
  ],
  "service": "backend",
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "forwardPorts": [
    "api:8000",
    "mock:8001",
    "prefect-server:4200",
    "frontend:2718",
    "minio:9000",
    "minio:9001"
  ],
  "postStartCommand": "uv sync --frozen --all-packages",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "marimo-team.marimo-vscode",
        "astral-sh.ty"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",  
        "python.defaultInterpreterPath": "${workspaceFolder}/.devcontainer/.venv/bin/python",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/backend",
          "${workspaceFolder}/api",
          "${workspaceFolder}/frontend",
          "${workspaceFolder}/utils",
          "${workspaceFolder}/mock"
        ],
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [],
        
        "python.languageServer": "None",

        // FORCE RUFF TO ACT AS THE FORMATTER IN THE UI
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
